# Copy to a private environment file; do not commit credentials or device data.
# HERMES_HOME is profile-local durable state for the plugin and relay.
HERMES_HOME=/absolute/path/to/private/hermes-profile
# Optional: explicit adb executable and serial.
# HERMES_PHONE_ADB=/usr/bin/adb
# HERMES_PHONE_ADB_SERIAL=DEVICE_SERIAL
# Required for owner-only outbound call policy and relay filtering.
HERMES_PHONE_OWNER=+15555550123
# Required only by the guarded call workflow.
# HERMES_PHONE_MODEL_SUPERVISOR=/absolute/path/to/private/model-supervisor.sh
